# Git 属性配置
# ---------------------------------------------------------------
# 统一换行符为 LF,避免 Windows 上 CRLF 导致跨平台 diff 噪声

# 默认:所有文本文件使用 LF 换行符
* text=auto eol=lf

# 明确标记二进制文件(不做换行符转换)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
