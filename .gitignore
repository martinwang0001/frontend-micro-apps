# ---- 依赖目录(npm workspaces 统一安装在根 node_modules) ----
node_modules/

# ---- 各子应用构建产物 ----
dist/
apps/*/dist/
# 合并部署产物(scripts/merge-dist.mjs 生成)
dist-merged/

# ---- 日志与临时文件 ----
*.log
.DS_Store
Thumbs.db

# ---- 编辑器目录 ----
.idea/
.vscode/

# ---- wrangler 本地开发状态目录(wrangler dev 运行时生成) ----
.wrangler/
